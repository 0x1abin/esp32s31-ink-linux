# NOR cramfs maps flash directly; SSH needs TCP/IP but no block devices.
# CONFIG_BLOCK is not set
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_PACKET is not set
# CONFIG_NETDEVICES is not set
# CONFIG_WIRELESS is not set
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_PHY_ESP32S31_USB is not set
# CONFIG_MMC is not set
CONFIG_MTD=y
CONFIG_MTD_ROM=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y
CONFIG_CRAMFS=y
CONFIG_CRAMFS_MTD=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
# CONFIG_TOUCHSCREEN_EDT_FT5X06 is not set
CONFIG_TOUCHSCREEN_METALIO_FT6336U=y
CONFIG_GPIO_PCA953X=y
CONFIG_REGMAP_MMIO=y
CONFIG_MFD_SYSCON=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_METALIO_EPD=y
CONFIG_METALIO_EPD_FAST_REFRESH=y
CONFIG_SERIAL_ESP32=y
CONFIG_SERIAL_ESP32_ACM=y
