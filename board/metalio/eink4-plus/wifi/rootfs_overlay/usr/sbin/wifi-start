#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu
umask 077
export LC_ALL=C

fail() {
    echo "Wi-Fi: $1" >&2
    exit 1
}

if ! mountpoint -q /data; then
    # Inspect an existing filesystem before allowing its garbage collector to write.
    mount -t jffs2 -o ro,nosuid,nodev,noexec mtd:data /data >/dev/null 2>&1 ||
        fail 'data partition unavailable; local terminal remains available.'
fi
awk '$2 == "/data" && $3 == "jffs2" { found = 1 } END { exit !found }' /proc/mounts ||
    fail 'data mount is not JFFS2.'
[ -f /data/.metalio-data-v1 ] && [ ! -L /data/.metalio-data-v1 ] &&
    [ "$(cat /data/.metalio-data-v1)" = metalio-data-v1 ] ||
    fail 'data partition is not initialized; it has not been formatted.'
mount -o remount,rw,nosuid,nodev,noexec /data >/dev/null 2>&1 ||
    fail 'data partition cannot be made writable.'

[ -e /data/wifi/wpa_supplicant.conf ] || exit 0
[ -d /data/wifi ] && [ ! -L /data/wifi ] &&
    [ "$(stat -c '%u:%a' /data/wifi)" = 0:700 ] &&
    [ -f /data/wifi/wpa_supplicant.conf ] && [ ! -L /data/wifi/wpa_supplicant.conf ] &&
    [ "$(stat -c '%u:%a' /data/wifi/wpa_supplicant.conf)" = 0:600 ] ||
    fail 'configuration must be a private root-owned file; run wifi-config.'
# Malformed configuration errors may contain its contents, so keep them off consoles.
ifup wlan0 >/dev/null 2>&1 || fail 'network start failed; inspect wpa_cli status.'
# The stock ifupdown hook returns success even when its supplicant command fails.
if [ "$(wpa_cli -i wlan0 ping 2>/dev/null)" != PONG ]; then
    wifi-stop
    fail 'supplicant start failed; run wifi-config to replace the configuration.'
fi
