+
+/*
+ * After DEINIT, the firmware has stopped Wi-Fi and drops the events of the
+ * old station, also a disconnect event that is still queued.  esp_stop()
+ * reports the disconnect itself, so do not wait for that event.
+ */
+void esp_mlme_drop_disconnect_wait(struct esp_wifi_device *priv)
+{
+	spin_lock_bh(&priv->bss_lock);
+	priv->disconnect_awaiting_mlme = false;
+	priv->disconnect_cmd_seq = 0;
+	spin_unlock_bh(&priv->bss_lock);
 }
 
