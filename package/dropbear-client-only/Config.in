config BR2_PACKAGE_DROPBEAR_CLIENT_ONLY
	bool "Dropbear SSH client"
	depends on !BR2_PACKAGE_DROPBEAR
	depends on !BR2_PACKAGE_OPENSSH_CLIENT
	help
	  Build only dbclient and provide an ssh command alias.
	  No SSH server or startup service is installed.

	  https://matt.ucc.asn.au/dropbear/dropbear.html
