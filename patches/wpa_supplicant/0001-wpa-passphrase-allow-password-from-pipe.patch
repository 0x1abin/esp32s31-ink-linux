From: Metalio BSP maintainers
Subject: [PATCH] wpa_passphrase: read passwords from non-terminal stdin

wpa_supplicant 2.11 disables terminal echo before reading stdin, which fails
with ENOTTY for a pipe. wifi-config already reads the password privately and
passes it through stdin so it does not appear in process arguments. Query
terminal attributes only for a terminal; zero attributes keep echo handling
inactive for a pipe. The original BSD license and author notices remain.

--- a/wpa_supplicant/wpa_passphrase.c
+++ b/wpa_supplicant/wpa_passphrase.c
@@ -15,7 +15,7 @@
 
 int main(int argc, char *argv[])
 {
-	struct termios term;
+	struct termios term = { 0 };
 	unsigned char psk[32];
 	int i;
 	char *ssid, *passphrase, buf[64], *pos;
@@ -36,7 +36,8 @@
 		bool ctrl_echo;
 
 		fprintf(stderr, "# reading passphrase from stdin\n");
-		if (tcgetattr(STDIN_FILENO, &term) < 0) {
+		if (isatty(STDIN_FILENO) &&
+		    tcgetattr(STDIN_FILENO, &term) < 0) {
 			perror("tcgetattr");
 			return 1;
 		}
