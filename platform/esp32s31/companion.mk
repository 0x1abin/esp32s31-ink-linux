# Hosted cannot attach custom probe IEs; these defaults add them to every scan.
WPA_SUPPLICANT_CONFIG_ENABLE += CONFIG_NO_ROBUST_AV
WPA_SUPPLICANT_CONFIG_DISABLE += CONFIG_BGSCAN_SIMPLE CONFIG_WNM

define ESP32S31_INSTALL_HOSTED_KERNEL
	$(BR2_EXTERNAL_ESP32S31_INK_LINUX_PATH)/kernel/esp32s31-hosted/install.sh $(@D)
	$(BR2_EXTERNAL_ESP32S31_INK_LINUX_PATH)/platform/esp32s31/patch-companion-kernel.sh $(@D)
endef
LINUX_POST_RSYNC_HOOKS += ESP32S31_INSTALL_HOSTED_KERNEL
LINUX_POST_PATCH_HOOKS += ESP32S31_INSTALL_HOSTED_KERNEL

define ESP32S31_INSTALL_COMPANION_OPENSBI
	mkdir -p $(@D)/platform/esp32s31
	cp -R $(BR2_EXTERNAL_ESP32S31_INK_LINUX_PATH)/platform/esp32s31/opensbi/. $(@D)/platform/esp32s31/
	$(BR2_EXTERNAL_ESP32S31_INK_LINUX_PATH)/platform/esp32s31/patch-opensbi.sh $(@D)
endef
OPENSBI_POST_RSYNC_HOOKS += ESP32S31_INSTALL_COMPANION_OPENSBI
OPENSBI_POST_PATCH_HOOKS += ESP32S31_INSTALL_COMPANION_OPENSBI
