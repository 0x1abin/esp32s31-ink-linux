+ * Must be called with s_time_update_lock held. */
+static inline void ESP_TIMER_IRAM_ATTR esp_timer_impl_rearm_alarm(void)
+{
+    esp_timer_impl_set_alarm_id(timestamp_id[ESP_TIMER_TASK], ESP_TIMER_TASK);
+}
