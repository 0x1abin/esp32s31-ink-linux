From: Metalio BSP maintainers
Subject: [PATCH] Add supervisor CLIC timer/IPI hooks

Adapted from Marco Mueller's BSD-2-Clause ESP32-S31 OpenSBI platform.
The ESP32-S31 delivers supervisor interrupts through CLIC IP registers.

--- a/lib/sbi/sbi_timer.c
+++ b/lib/sbi/sbi_timer.c
@@ -129,6 +129,16 @@
 	*(time_delta + 1) = delta_upper;
 }
 #endif
+
+void __attribute__((weak)) sbi_timer_plat_sirq_set(void)
+{
+	csr_set(CSR_MIP, MIP_STIP);
+}
+
+void __attribute__((weak)) sbi_timer_plat_sirq_clear(void)
+{
+	csr_clear(CSR_MIP, MIP_STIP);
+}
 
 void sbi_timer_event_start(u64 next_event)
 {
@@ -147,7 +157,7 @@
 #endif
 	} else if (timer_dev && timer_dev->timer_event_start) {
 		timer_dev->timer_event_start(next_event);
-		csr_clear(CSR_MIP, MIP_STIP);
+		sbi_timer_plat_sirq_clear();
 	}
 	csr_set(CSR_MIE, MIP_MTIP);
 }
@@ -161,7 +171,7 @@
 	 * only invoked if M-mode programs the timer for its own purpose.
 	 */
 	if (!sbi_hart_has_extension(sbi_scratch_thishart_ptr(), SBI_HART_EXT_SSTC))
-		csr_set(CSR_MIP, MIP_STIP);
+		sbi_timer_plat_sirq_set();
 }
 
 const struct sbi_timer_device *sbi_timer_get_device(void)
@@ -218,6 +228,6 @@
 	if (timer_dev && timer_dev->timer_event_stop)
 		timer_dev->timer_event_stop();
 
-	csr_clear(CSR_MIP, MIP_STIP);
+	sbi_timer_plat_sirq_clear();
 	csr_clear(CSR_MIE, MIP_MTIP);
 }
--- a/include/sbi/sbi_timer.h
+++ b/include/sbi/sbi_timer.h
@@ -104,4 +104,8 @@
 /* Exit timer */
 void sbi_timer_exit(struct sbi_scratch *scratch);
 
+/* Platform hooks for CLIC-only supervisor interrupt delivery. */
+void sbi_timer_plat_sirq_set(void);
+void sbi_timer_plat_sirq_clear(void);
+
 #endif
--- a/lib/sbi/sbi_ipi.c
+++ b/lib/sbi/sbi_ipi.c
@@ -180,9 +180,19 @@
 	ipi_ops_array[event] = NULL;
 }
 
+void __attribute__((weak)) sbi_ipi_plat_sirq_set(void)
+{
+	csr_set(CSR_MIP, MIP_SSIP);
+}
+
+void __attribute__((weak)) sbi_ipi_plat_sirq_clear(void)
+{
+	csr_clear(CSR_MIP, MIP_SSIP);
+}
+
 static void sbi_ipi_process_smode(struct sbi_scratch *scratch)
 {
-	csr_set(CSR_MIP, MIP_SSIP);
+	sbi_ipi_plat_sirq_set();
 }
 
 static struct sbi_ipi_event_ops ipi_smode_ops = {
@@ -199,7 +209,7 @@
 
 void sbi_ipi_clear_smode(void)
 {
-	csr_clear(CSR_MIP, MIP_SSIP);
+	sbi_ipi_plat_sirq_clear();
 }
 
 static int sbi_ipi_update_halt(struct sbi_scratch *scratch,
--- a/include/sbi/sbi_ipi.h
+++ b/include/sbi/sbi_ipi.h
@@ -97,4 +97,8 @@
 
 void sbi_ipi_exit(struct sbi_scratch *scratch);
 
+/* Platform hooks for CLIC-only supervisor interrupt delivery. */
+void sbi_ipi_plat_sirq_set(void);
+void sbi_ipi_plat_sirq_clear(void);
+
 #endif
